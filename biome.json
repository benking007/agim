{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!src/core/skills/builtin/**",
      "!**/*.generated.*",
      "!**/dist/**",
      "!src/web/public/**"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noUnknownAtRules": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/web-app/src/components/common/data-table.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
