{
  "name": "im-hub-pro",
  "version": "0.3.0",
  "description": "Universal messenger-to-agent bridge — connect WeChat/Feishu/Telegram/Discord to Claude Code/Codex/Copilot/OpenCode, or any custom agent via ACP",
  "type": "module",
  "bin": {
    "im-hub-pro": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/web/public && cp -r src/web/public dist/web/public && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome lint src test",
    "format": "biome format . --write",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wechat",
    "feishu",
    "telegram",
    "discord",
    "claude-code",
    "codex",
    "copilot",
    "opencode",
    "bot",
    "agent",
    "bridge",
    "acp"
  ],
  "author": "Jerry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benking007/imhub.git"
  },
  "homepage": "https://github.com/benking007/imhub#readme",
  "bugs": {
    "url": "https://github.com/benking007/imhub/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/nodemailer": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^11.0.0",
    "discord.js": "^14.26.3",
    "grammy": "^1.41.1",
    "marked": "^17.0.5",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.20.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
